{
  "name": "@nimbus-labs/ui",
  "version": "1.0.0",
  "description": "Shared MUI theme and navigation primitives for Nimbus Labs apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@mui/material": "^7.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@emotion/react": "*",
    "@emotion/styled": "*",
    "@eslint/js": "*",
    "@mui/material": "*",
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "eslint": "*",
    "eslint-plugin-react-hooks": "*",
    "eslint-plugin-react-refresh": "*",
    "globals": "*",
    "jsdom": "*",
    "prettier": "*",
    "react": "*",
    "react-dom": "*",
    "react-router-dom": "*",
    "typescript": "*",
    "typescript-eslint": "*",
    "vitest": "*"
  },
  "author": "James Craver",
  "license": "MIT"
}
